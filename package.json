{
  "name": "universal-form-validator",
  "version": "1.1.0",
  "description": "A framework-agnostic, zero-dependency form validation engine.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "unpkg": "dist/validator.min.js",
  "jsdelivr": "dist/validator.min.js",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GamersStop/universal-form-validator.git"
  },
  "bugs": {
    "url": "https://github.com/GamersStop/universal-form-validator/issues"
  },
  "homepage": "https://github.com/GamersStop/universal-form-validator#readme",
  "scripts": {
    "pretest": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "build": "node build.js",
    "example:ts": "tsx examples/example.ts",
    "example:serve": "node examples/server.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "form",
    "validation",
    "validator",
    "zero-dependency",
    "vanilla-js",
    "html-validation"
  ],
  "author": "Mayuresh Pandit",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}